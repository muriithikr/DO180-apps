# Copy to .env (never commit real credentials) and export before `npm start`.
# mock | sandbox | production   (defaults to mock when no consumer key is set)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# Sandbox defaults to the public test shortcode 174379 and its passkey.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till / Buy Goods)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Buy Goods: till number here, store number in MPESA_SHORTCODE
MPESA_PARTY_B=
# Public HTTPS URL Safaricom will POST results to; end it with your secret token.
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback/change-me-long-random-string
MPESA_CALLBACK_TOKEN=change-me-long-random-string
MPESA_ACCOUNT_REFERENCE=DukaShop
# Bearer token for GET /api/admin/orders (endpoint disabled if empty)
ADMIN_TOKEN=
# Persist orders to a JSON file (in-memory only if unset)
ORDERS_FILE=./data/orders.json
PORT=8080
